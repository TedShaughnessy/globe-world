{
	"schemaVersion": 1,
	"id": "globe-world",
	"version": "${version}",
	"name": "Globe World",
	"description": "Makes a finite canonical Minecraft world tile feel continuous by wrapping chunk, block, entity, and render-facing access across X/Z.",
	"authors": [
		"${mod_author}"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_sources}"
	},
	"license": "CC0-1.0",
	"icon": "assets/globe-world/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"globe.world.GlobeWorld"
		],
		"client": [
			"globe.world.client.GlobeWorldClient"
		]
	},
	"mixins": [
		"globe-world.mixins.json",
		{
			"config": "globe-world.client.mixins.json",
			"environment": "client"
		},
		{
			"config": "globe-world.iris.mixins.json",
			"environment": "client"
		},
		{
			"config": "globe-world.sodium.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
